// Package lib checks values.
package lib

// Checker checks one value.
type Checker interface {
	Check() bool
}

// Limiter is a published checker.
type Limiter struct{}

// Check reports true.
func (*Limiter) Check() bool { return true }

type quiet struct{}

func (quiet) Check() bool { return false }

var _ Checker = (*Limiter)(nil)

