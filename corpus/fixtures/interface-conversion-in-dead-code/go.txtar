-- target/store/store.go --
package store

// Store finds a value by name.
type Store interface {
	Find(name string) string
}

// Plain is the store the command converts to Store.
type Plain struct{}

// Find returns the name it is given.
func (Plain) Find(name string) string { return name }

// encrypted is built by newEncrypted alone.
type encrypted struct{ key string }

// Find prefixes the name with the key.
func (e *encrypted) Find(name string) string { return e.key + name }

// newEncrypted converts an encrypted store to Store, and nothing calls it.
func newEncrypted() Store { return &encrypted{key: "k"} }

// Use finds one name through the interface.
func Use(s Store) string { return s.Find("x") }
