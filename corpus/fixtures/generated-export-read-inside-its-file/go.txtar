-- target/catalog/catalog.go --
package catalog

// Live is called by the command and by the test.
func Live() int { return 1 }
-- target/catalog/catalog_test.go --
package catalog_test

import (
	"testing"

	"example.com/target/catalog"
	"example.com/target/wire"
)

func TestLive(t *testing.T) {
	if catalog.Live() != len(wire.ArbitraryList()) {
		t.Error("Live and the list disagree")
	}
}
-- target/wire/wire_types.go --
// Code generated by wiretool. DO NOT EDIT.

package wire

// ArbitraryEntry is read inside this file alone.
func ArbitraryEntry() int { return 1 }

// ArbitraryList is called by a test.
func ArbitraryList() []int { return []int{ArbitraryEntry()} }
