-- target/pop/pop.go --
// Package pop connects to servers.
package pop

import "net"

// Dialer opens connections.
type Dialer interface {
	Dial(network, address string) (net.Conn, error)
}

// Options configures a connection.
type Options struct {
	Host   string
	dialer Dialer
}

// Connect names the host it would connect to.
func Connect(o Options) string { return o.Host }

// Value is any value a source returns.
type Value any

// Source names and reads values.
type Source interface {
	Name() string
	Read() Value
}

type source struct{}

func (source) Name() string { return "source" }

func (source) Read() Value { return nil }

// NewSource returns a source.
func NewSource() Source { return source{} }
