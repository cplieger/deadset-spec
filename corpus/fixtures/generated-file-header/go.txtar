The Go rendering: an application reading a table from a generated file, with one
function of that file named by nothing, beside a file that writes the header
after its package clause.

-- fixture.json --
{
  "symbols": {
    "lateSize": { "file": "target/late.go", "line": 5 },
    "tableSize": { "file": "target/table.go", "line": 7 }
  }
}
-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
// Command target writes one entry of the generated table.
package main

import "os"

func main() {
	if _, err := os.Stdout.WriteString(table["one"]); err != nil {
		panic(err)
	}
}
-- target/table.go --
// Code generated by the table generator. DO NOT EDIT.

package main

var table = map[string]string{"one": "1"}

func tableSize() int { return len(table) }
-- target/late.go --
