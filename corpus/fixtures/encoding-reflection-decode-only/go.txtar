-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
// Command target reads a settings document from standard input.
package main

import (
	"encoding/json"
	"os"
)

// settings is decoded, and only its name and its level are read.
type settings struct {
	Name  string `json:"name"`
	Theme string `json:"theme"`
	Level level  `json:"level"`
}

// level decodes itself from a document.
type level int

// UnmarshalJSON is called by the decoder.
func (l *level) UnmarshalJSON(data []byte) error {
	*l = level(len(data))
	return nil
}

// Describe is called by nothing.
func (level) Describe() string { return "level" }

func main() {
	var s settings
	if err := json.NewDecoder(os.Stdin).Decode(&s); err != nil {
		panic(err)
	}
	println(s.Name, int(s.Level))
}
