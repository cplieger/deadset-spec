-- target/go.mod --
module example.com/target

go 1.27.0
-- target/page.go --
// Package target renders pages.
package target

import (
	"io"
	"text/template"
)

type page struct {
	Title string
	Body  string
	tag   string
}

var pageT = template.Must(template.New("p").Parse("{{.Title}} {{.Body}}\n"))

// Render writes a page with a title.
func Render(w io.Writer, title string) error {
	return pageT.Execute(w, page{Title: title})
}
