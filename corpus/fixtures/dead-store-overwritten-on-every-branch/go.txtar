module example.com/target

go 1.27.0
-- target/main.go --
// Command target picks a label.
package main

import "os"

func main() {
	label := "none"
	if len(os.Args) > 1 {
		label = "some"
	} else {
		label = "empty"
	}
	println(label)

	kept := "kept"
	if len(os.Args) > 2 {
		kept = "many"
	}
	println(kept)
}
