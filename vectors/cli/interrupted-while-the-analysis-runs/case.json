{
  "description": "A run sent an interrupt while the toolchain loads the target's packages stops the analysis and ends with exit code 3 and the run failure interrupted-run, before any report is written.",
  "products": [
    "deadset-go"
  ],
  "rename": {
    "go.mod.txt": "go.mod",
    "main.go.txt": "main.go"
  },
  "executables": [
    "bin/go"
  ],
  "env": {
    "PATH": "@TARGET@/bin:/usr/bin:/bin"
  },
  "interrupt": "@TARGET@/started",
  "argv": [
    "analyze",
    "--target=@TARGET@",
    "--report=@OUT@/report.json"
  ],
  "expect": {
    "exit": 3,
    "stderr_contains": [
      "run failure: interrupted-run: "
    ],
    "report": "absent"
  }
}
