package main

import (
	"math"
	"time"
)

// The two durations an iota group declares carry a type the standard library
// declares, which has a String method and which measure converts an integer to.
const (
	rttFailed = time.Duration(math.MaxInt64 - iota)
	rttUntested
)

// measure converts an integer to a duration, or returns the failure value.
func measure(n int64) time.Duration {
	if n < 0 {
		return rttFailed
	}
	return time.Duration(n)
}
