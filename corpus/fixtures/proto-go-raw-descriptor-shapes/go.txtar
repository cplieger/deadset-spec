// Package proto stands in for the protobuf runtime's message functions.
package proto

import "google.golang.org/protobuf/reflect/protoreflect"

// Message is a generated message.
type Message interface {
	ProtoReflect() protoreflect.Message
}

// Marshal encodes a message.
func Marshal(Message) ([]byte, error) { return nil, nil }

// Unmarshal decodes a message.
func Unmarshal([]byte, Message) error { return nil }

// Size is a message's encoded size.
func Size(Message) int { return 0 }

// Equal compares two messages.
func Equal(a, b Message) bool { return a == b }
