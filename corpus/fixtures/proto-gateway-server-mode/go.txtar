-- target/main.go --
// Command target serves the RPC over HTTP through the gateway.
package main

import (
	"context"
	"net/http"

	v1 "example.com/target/gen/v1"
	"github.com/grpc-ecosystem/grpc-gateway/v2/runtime"
)

type server struct {
	v1.UnimplementedPingServiceServer
}

func (server) Ping(_ context.Context, request *v1.PingRequest) (*v1.PingResponse, error) {
	return &v1.PingResponse{Number: request.GetNumber()}, nil
}

func main() {
	mux := runtime.NewServeMux()
	if err := v1.RegisterPingServiceHandlerServer(context.Background(), mux, server{}); err != nil {
		return
	}
	_ = http.ListenAndServe("localhost:8080", mux)
}
-- target/proto/v1/service.proto --
syntax = "proto3";

package v1;

option go_package = "example.com/target/gen/v1;v1";

message PingRequest {
  int32 number = 1;
  string text = 2 [json_name = "words"];
}

message PingResponse {
  int32 number = 1;
}

service PingService {
  rpc Ping(PingRequest) returns (PingResponse);
}
