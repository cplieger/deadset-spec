go 1.27.0
-- yaml/yaml.go --
// Package yaml stands in for gopkg.in/yaml.v3: its decoder takes the destination as any.
package yaml

// Unmarshal decodes in into out.
func Unmarshal(in []byte, out any) error {
	_, _ = in, out
	return nil
}
