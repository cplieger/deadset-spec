-- target/main.go --
// Command target constructs one message of each generated file.
package main

import (
	"fmt"

	v1 "example.com/target/gen/v1"
)

func main() {
	fmt.Println(&v1.Alpha{Value: 1}, &v1.Beta{Value: 2}, &v1.Gamma{Value: 3})
}
