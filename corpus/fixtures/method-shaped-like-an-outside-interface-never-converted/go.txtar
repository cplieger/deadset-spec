-- target/store/store.go --
// Package store holds bytes.
package store

import "io"

// Store holds bytes.
type Store struct{ data []byte }

// New returns an empty store.
func New() *Store { return &Store{} }

// Read has the signature io.Reader fixes.
func (s *Store) Read(p []byte) (int, error) { return copy(p, s.data), io.EOF }

// Size is the number of bytes held.
func (s *Store) Size() int { return len(s.data) }
