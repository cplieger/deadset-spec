{
  "describe": {
    "stdout": "describe.json"
  },
  "arms": [
    {
      "when": {
        "scope_contains": "/rerun/"
      },
      "stderr": [
        "loading the narrowed scope",
        "setup failure: no-program: the target holds no package this build loads: run from the directory that holds one, or name the languages to analyze"
      ],
      "exit": 3
    },
    {
      "writes": {
        "report": "report.json"
      },
      "identity": {
        "default": "example.com/api"
      },
      "exit": 0
    }
  ]
}
