-- dep/go.mod --
module example.com/dep

go 1.27.0
-- dep/dep.go --
package dep

import (
	"encoding/json"
	"io"
)

func Fetch[T any](r io.Reader) (T, error) {
	var t T
	err := json.NewDecoder(r).Decode(&t)
	return t, err
}

func Like[T any](_ T, r io.Reader) (T, error) {
	var t T
	err := json.NewDecoder(r).Decode(&t)
	return t, err
}

type Client struct{ R io.Reader }

func (c *Client) Get[T any]() (T, error) {
	var t T
	err := json.NewDecoder(c.R).Decode(&t)
	return t, err
}

type Stream[T any] struct{ R io.Reader }

func (s Stream[T]) Next() (T, error) {
	var t T
	err := json.NewDecoder(s.R).Decode(&t)
	return t, err
}
-- dep/plain/plain.go --
package plain

func Keep[T any](t T) T { return t }
-- dep/relay/relay.go --
package relay

import (
	"io"

	"example.com/dep/codec"
)

func Load[T any](r io.Reader) (T, error) {
	var t T
	err := codec.Decode(r, &t)
	return t, err
}
-- dep/codec/codec.go --
package codec

import (
	"encoding/json"
	"io"
)

func Decode(r io.Reader, v any) error { return json.NewDecoder(r).Decode(v) }
