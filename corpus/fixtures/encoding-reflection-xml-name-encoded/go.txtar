module example.com/target

go 1.27.0
-- target/main.go --
// Command target encodes one item.
package main

import (
	"encoding/xml"
	"os"
)

type item struct {
	XMLName xml.Name `xml:"item"`
	Title   string   `xml:"title"`
	Spare   string   `xml:"-"`
}

func main() {
	if err := xml.NewEncoder(os.Stdout).Encode(item{Title: "t"}); err != nil {
		panic(err)
	}
}
