  "symbols": {
    "label.String": { "file": "target/main.go", "line": 16 },
    "controller.Login": { "file": "target/main.go", "line": 21 },
    "controller.Archive": { "file": "target/main.go", "line": 24 },
    "controller.Logout": { "file": "target/main.go", "line": 27 },
    "badge.String": { "file": "target/main.go", "line": 32 },
    "stamp.String": { "file": "target/main.go", "line": 37 },
    "rec.alias": { "file": "target/main.go", "line": 39 },
    "row.title": { "file": "target/main.go", "line": 41 },
    "fieldLevel.Mid": { "file": "target/levels.go", "line": 16 },
    "fieldLevel.Top": { "file": "target/levels.go", "line": 18 },
    "mapLevel.Mid": { "file": "target/levels.go", "line": 26 },
    "methodLevel.Mid": { "file": "target/levels.go", "line": 35 },
