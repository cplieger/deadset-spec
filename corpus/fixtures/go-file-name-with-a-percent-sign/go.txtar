The Go rendering: one main package under a matrix of one configuration, and a
file named with a percent sign whose constraint names a tag no configuration sets.

-- fixture.json --
{
  "configurations": [
    "linux-amd64"
  ],
  "symbols": {
    "Handwritten": {
      "file": "target/100%_x.go",
      "line": 1,
      "ref": "go://example.com/fixture#100%25_x.go:file"
    }
  }
}
-- target/go.mod --
module example.com/fixture

go 1.27.0
-- target/main.go --
package main

func main() {}
-- target/100%_x.go --
//go:build handwritten

package main

// handwritten is compiled under a tag no configuration of the matrix names.
func handwritten() int { return 4 }
