-- target/go.mod --
module example.com/m

go 1.27.0
-- target/main.go --
package main

import (
	"example.com/m/lib"
	"example.com/m/node_modules/helper"
)

func main() { lib.Used(); helper.Imported() }
-- target/lib/lib.go --
package lib

// Used is what main calls.
func Used() {}

// Unused is called by nothing.
func Unused() {}

// Callback is called by installed code alone.
func Callback() {}
-- target/node_modules/helper/helper.go --
package helper

import "example.com/m/lib"

// Imported is installed code main calls, which calls back into the module.
func Imported() { lib.Callback() }

// ImportedSpare is installed code nothing calls.
func ImportedSpare() {}
