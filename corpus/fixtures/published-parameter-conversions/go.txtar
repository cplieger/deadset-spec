module example.com/registry

go 1.27.0
-- target/registry.go --
package registry

import "fmt"

type Metric interface {
	registerInto(r *Registry)
}

type Hook interface {
	attach(r *Registry)
}

type Sink interface {
	Write(p []byte) (int, error)
}

type Sampler interface {
	sample() int
}

type tracker interface {
	track()
}

type Registry struct {
	names []string
}

func (r *Registry) Register(m Metric) {
	m.registerInto(r)
	r.Attach()
}

func (r *Registry) Attach(hs ...Hook) {
	for _, h := range hs {
		h.attach(r)
	}
}

func (r *Registry) MustRegister(s Sink, ms ...Metric) error {
	for _, m := range ms {
		r.Register(m)
	}
	return Emit(s, r.names)
}

func Emit(s Sink, names []string) error {
	for _, name := range names {
		if _, err := s.Write([]byte(name)); err != nil {
			return err
		}
	}
	return nil
}

func Sample[S Sampler](s S) int { return s.sample() }

func Track(t tracker) { t.track() }

func Describe(v fmt.Stringer) string { return v.String() }

func NewTally() *tally { return &tally{} }

var Default = &spool{}

type Bundle struct {
	Extra *extra
}

func Mute(q *quiet) int { return q.level }

func Report(err error) string { return err.Error() }

type Shelf struct {
	*shelf
}

type shelf struct {
	Stock *stock
}

const Debug level = 0

func NewPlain() plain { return plain{} }

type Scorer interface {
	score() int
}

func ScoreAll[S Scorer](ss []S) int {
	total := 0
	for _, s := range ss {
		total += s.score()
	}
	return total
}

type Station struct {
	dock
}

type dock struct{}

func (dock) Moor(b Berth) { b.moor() }

type Berth interface {
	moor()
}
