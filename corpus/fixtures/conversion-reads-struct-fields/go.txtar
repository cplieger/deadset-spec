-- target/main.go --
package main

import "encoding/json"

type shared struct {
	Seen   string
	Hidden string
}

type box[T any] struct {
	V T
}

type outerA struct {
	S     shared
	Items []struct {
		P int
		Q int
	}
	Index map[string]struct {
		K int
	}
	Ptr *struct {
		Deep int
	}
	Gen box[struct {
		G int
	}]
	Hook interface {
		Get() struct {
			Z int
		}
	}
}

type outerB struct {
	S     shared `json:"s"`
	Items []struct {
		P int
		Q int
	}
	Index map[string]struct {
		K int
	}
	Ptr *struct {
		Deep int
	}
	Gen box[struct {
		G int
	}]
	Hook interface {
		Get() struct {
			Z int
		}
	}
}

type src struct {
	Name string
}

type dst struct {
	Name string
}

type from struct {
	Title string
}

type wireT struct{ Title string }

type pair struct {
	Left  string
	Right string
}

type wire struct{ Left, Right string }

type kept struct {
	Lost string
}

type boxed struct {
	Hidden string
}

type record struct {
	X int
	Y int
}

func (r *record) UnmarshalJSON(b []byte) error {
	type plain record
	return json.Unmarshal(b, (*plain)(r))
}

func toWire[P ~struct{ Left, Right string }](p P) wire { return wire(p) }

func toParam[T ~struct{ Title string }](f from) T { return T(f) }

func keep[T any](t T) { println(any(t) != nil) }

func main() {
	var a outerA
	a.S.Seen = "s"
	a.S.Hidden = "h"
	a.Items = nil
	a.Index = nil
	a.Ptr = nil
	a.Gen = box[struct{ G int }]{}
	a.Hook = nil
	b := outerB(a)
	_ = b.Gen.V
	println(b.S.Seen, len(b.Items), len(b.Index), b.Ptr == nil, b.Hook == nil)

	var s src
	s.Name = "n"
	println((*dst)(&s) != nil)

	var f from
	f.Title = "t"
	println(toParam[wireT](f) == wireT{})

	var p pair
	p.Left, p.Right = "l", "r"
	println(toWire(p) == wire{})

	var k kept
	k.Lost = "x"
	keep(k)

	var bx boxed
	bx.Hidden = "h"
	println(any(bx) != nil)

	var r record
	if err := json.Unmarshal([]byte(`{"X":1}`), &r); err == nil {
		println(r.X, record(r).X)
	}
}
