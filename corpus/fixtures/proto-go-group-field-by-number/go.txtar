// Command target constructs a message of each schema file.
package main

import (
	"fmt"

	v1 "example.com/target/gen/v1"
)

func main() {
	fmt.Println(&v1.Search{Result: &v1.Search_Result{}}, &v1.Query{Filter: &v1.Filter{}})
}
-- target/proto/v1/query.proto --
edition = "2023";

package v1;

option go_package = "example.com/target/gen/v1;v1";

message Filter {
  string term = 1;
}

message Query {
  Filter filter = 1 [features.message_encoding = DELIMITED];
}
