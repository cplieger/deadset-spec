#!/bin/sh
dir=$(dirname "$0")
scope='' report=''
if [ "$1" = describe ]; then
	exec cat "$dir/describe.json"
fi
for arg in "$@"; do
	case $arg in
	--scope=*) scope=${arg#--scope=} ;;
	--report=*) report=${arg#--report=} ;;
	esac
done
# The run again, over the scope without TypeScript, finds no program.
case $scope in
*/rerun/*)
	echo 'loading the narrowed scope' >&2
	echo 'setup failure: no-program: the target holds no package this build loads: run from the directory that holds one, or name the languages to analyze' >&2
	exit 3
	;;
esac
sed 's|"identity": "IDENTITY"|"identity": "example.com/api"|' "$dir/report.json" >"$report"
exit 0
