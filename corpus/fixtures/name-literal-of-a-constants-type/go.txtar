-- target/go.mod --
module example.com/app

go 1.27.0
-- target/main.go --
package main

import (
	"fmt"

	"example.com/app/internal/wire"
)

var registry = map[string]int{"Kind": 1}

func main() {
	fmt.Println(len(registry), wire.Describe())
}
-- target/internal/wire/wire.go --
package wire

import "fmt"

type Kind int

const (
	KindA Kind = iota
	KindB
)

type Mode int

const (
	ModeA Mode = iota
	ModeB
)

func Describe() string { return fmt.Sprint(KindA, KindB, ModeA, ModeB) }
