-- target/main.go --
// Command target tells oneof members apart.
package main

import (
	"fmt"

	v1 "example.com/target/gen/v1"
)

func describe(outcome *v1.Outcome) string {
	switch result := outcome.Result.(type) {
	case *v1.Outcome_Ok:
		return result.Ok
	case nil:
		return "unset"
	default:
		return "other"
	}
}

func failed(outcome *v1.Outcome) bool {
	_, ok := outcome.Result.(*v1.Outcome_Error)
	return ok
}

func waiting(outcome *v1.Outcome) bool {
	return outcome.WhichResult() == v1.Outcome_Pending_case
}

func set(probe *v1.Probe) bool {
	return probe.Value != nil
}

func main() {
	outcome := &v1.Outcome{Result: &v1.Outcome_Skipped{Skipped: 1}}
	fmt.Println(describe(outcome), failed(outcome), waiting(outcome), set(&v1.Probe{}))
}
