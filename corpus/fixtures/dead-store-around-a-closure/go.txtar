    "ReadByClosure": { "file": "target/main.go", "line": 26 },
    "StoredAfterClosure": { "file": "target/main.go", "line": 28 },
    "BeforeLoop": { "file": "target/main.go", "line": 34 },
    "LoopBeforeClosure": { "file": "target/main.go", "line": 37 },
    "LoopAfterClosure": { "file": "target/main.go", "line": 39 },
    "StoredAfterACall": { "file": "target/main.go", "line": 48 },
