// wideC is the lane count of the architecture.
const wideC = lanesC(3)
-- target/widec_arm.go --
package main

// wideC is the lane count of the architecture.
const wideC = lanesC(2)
-- target/widec_arm64.go --
package main

// wideC is the lane count of the architecture.
const wideC = lanesC(3)
