-- target/shape/shape.go --
package shape

// Sizer reports a size.
type Sizer interface {
	Size() int
}

// Box is passed as a type argument and never converted to Sizer.
type Box struct{ width int }

// Size returns the width.
func (b Box) Size() int { return b.width }

// Total adds the sizes of its values, calling Size through the constraint.
func Total[S Sizer](values ...S) int {
	sum := 0
	for _, v := range values {
		sum += v.Size()
	}
	return sum
}
