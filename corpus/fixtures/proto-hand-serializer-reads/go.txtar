// Command target encodes a generated message.
package main

import (
	"os"

	v1 "example.com/target/gen/v1"
	"google.golang.org/protobuf/proto"
)

func main() {
	data, err := proto.Marshal(&v1.Envelope{Item: &v1.Item{Number: 1}})
	if err != nil {
		os.Exit(1)
	}
	_, _ = os.Stdout.Write(data)
	_ = &v1.Other{Number: 2}
}
-- target/proto/v1/envelope.proto --
syntax = "proto3";

package v1;

option go_package = "example.com/target/gen/v1;v1";

message Item {
  int32 number = 1;
  string text = 2;
}

message Envelope {
  Item item = 1;
  string label = 2;
}

message Other {
  int32 number = 1;
}
