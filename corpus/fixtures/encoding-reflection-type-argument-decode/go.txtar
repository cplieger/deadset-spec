-- target/main.go --
package main

import (
	"fmt"
	"os"

	"example.com/app/internal/model"
	"example.com/dep"
	"example.com/dep/plain"
	"example.com/dep/relay"
)

var (
	_ model.FlexA
	_ model.FlexB
	_ model.FlexC
	_ model.FlexD
	_ model.FlexE
	_ model.FlexF
)

func get[T any]() (T, error) { return dep.Fetch[T](os.Stdin) }

func main() {
	a, _ := get[model.ItemA]()
	c := &dep.Client{R: os.Stdin}
	b, _ := c.Get[model.ItemB]()
	s := dep.Stream[model.ItemC]{R: os.Stdin}
	cc, _ := s.Next()
	d := plain.Keep(model.ItemD{})
	e, _ := dep.Like(model.ItemE{}, os.Stdin)
	f, _ := relay.Load[model.ItemF](os.Stdin)
	fmt.Println(a.N, b.N, cc.N, d.N, e.N, f.N)
}
