-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
// Command target encodes one record and decodes one feed.
package main

import (
	"encoding/json"
	"encoding/xml"
	"os"
)

// record is encoded, and nothing reads its fields by name.
type record struct {
	ID     string `json:"id"`
	Secret string `json:"-"`
	Dash   string `json:"-,"`
}

// feed is decoded from an XML document, and nothing reads its fields by name.
type feed struct {
	XMLName xml.Name `xml:"feed"`
	Title   string   `xml:"title"`
}

func main() {
	data, err := json.Marshal(record{})
	if err != nil {
		panic(err)
	}
	var f feed
	if err := xml.NewDecoder(os.Stdin).Decode(&f); err != nil {
		panic(err)
	}
	println(len(data))
}
