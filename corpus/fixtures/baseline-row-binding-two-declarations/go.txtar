-- target/go.mod --
module example.com/app

go 1.27.0
-- target/main.go --
package main

// The first init holds a statement after its return.
func init() {
	println("before the return")
	return
	println("after the return")
}

// The second init holds no statement after a return.
func init() {
	println("reached")
}

func main() {}
