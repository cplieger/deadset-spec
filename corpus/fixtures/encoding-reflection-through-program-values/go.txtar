-- target/main.go --
package main

import (
	"encoding/json"
	"net/http"
	"reflect"
)

type shadowed struct {
	A string `json:"a"`
}

type shadow shadowed

type flex int

func (*flex) UnmarshalJSON([]byte) error { return nil }

type request struct {
	K flex `json:"k"`
}

func decode[T any](b []byte) (T, error) {
	var v T
	err := json.Unmarshal(b, &v)
	return v, err
}

type raw []byte

func (r raw) MarshalJSON() ([]byte, error) { return r, nil }

func reencode(from any) ([]byte, error) { return json.Marshal(from) }

type inner struct {
	X int `json:"x"`
}

type outer struct {
	inner
}

type ack struct {
	ID string `json:"id"`
}

func handle() (any, error) { return ack{ID: "x"}, nil }

func route(w http.ResponseWriter) {
	v, err := handle()
	if err != nil {
		return
	}
	_ = json.NewEncoder(w).Encode(v)
}

type unsent struct {
	ID string `json:"id"`
}

func drop() any { return unsent{ID: "y"} }

type closed struct {
	ID string `json:"id"`
}

func wrap() any {
	f := func() any { return closed{ID: "z"} }
	return f
}

type replied struct {
	OK bool `json:"ok"`
}

type handler func() (any, error)

func answer() (any, error) { return replied{OK: true}, nil }

var handlers = map[string]handler{"answer": answer}

func dispatch(name string) {
	body, err := handlers[name]()
	if err != nil {
		return
	}
	_, _ = json.Marshal(body)
}

type provider struct{}

type made struct {
	ID string `json:"id"`
}

func (provider) build() any { return made{ID: "m"} }

func viaMethodValue() {
	makeValue := provider{}.build
	_, _ = json.Marshal(makeValue())
}

func main() {
	viaMethodValue()
	println(reflect.TypeFor[shadow]().NumField(), shadow{A: "a"}.A != "")
	dispatch("answer")
	r, err := decode[request](nil)
	println(r.K, err)
	b, err := reencode(raw("{}"))
	println(len(b), err)
	_, _ = json.Marshal(outer{inner{1}})
	route(nil)
	println(drop() != nil)
	_, _ = json.Marshal(wrap())
}
