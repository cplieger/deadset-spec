The Go rendering: a generated file whose functions the provides sides of two
declared edges name, one called by the entry and one called by nothing, beside
a function of the same file no edge names.

-- fixture.json --
{
  "symbols": {
    "encode": { "file": "target/wire.go", "line": 6 },
    "decode": { "file": "target/wire.go", "line": 11 },
    "checksum": { "file": "target/wire.go", "line": 16 }
  }
}
-- target/go.mod --
module example.com/app

go 1.27.0
-- target/main.go --
package main

// The entry calls one function of the generated file.
func main() {
	println(encode(1))
}
-- target/wire.go --
// Code generated by the wire generator. DO NOT EDIT.

package main

// encode is called by the entry and named by the edge wire/encode.
func encode(n int) int {
	return n * 2
}

// decode is named by the edge wire/decode and referenced by nothing.
func decode(n int) int {
	return n / 2
}

// checksum is named by no edge and referenced by nothing.
func checksum(n int) int {
	return n % 7
}
-- target/deadset-edges.json --
{
  "description": "Two edges whose provides sides name functions of the generated file.",
  "edges": {
    "wire/encode": {
      "because": "generated",
      "provides": "go://example.com/app#encode",
      "used_by": "ts://@example/web/src/wire.ts#encode"
    },
    "wire/decode": {
      "because": "generated",
      "provides": "go://example.com/app#decode",
      "used_by": "ts://@example/web/src/wire.ts#decode"
    }
  }
}
