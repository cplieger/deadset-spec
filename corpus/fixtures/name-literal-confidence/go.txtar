package api

import "testing"

func TestNames(t *testing.T) {
	if spelledTested+testSpelledTested == 0 || len(selfSpelledTested) == 0 || (box{count: 1}).count == 0 {
		t.Fatal("zero")
	}
	for _, name := range []string{
		"TestSpelled", "testSpelledConst", "testSpelledTested", "testSpelledOld",
		"TestSpelledLocal", "TestSpelledExposed", "TestSpelledGone",
	} {
		if name == "" {
			t.Fatal("empty")
		}
	}
}
