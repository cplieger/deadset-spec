// Command target serves both versions of the RPC.
package main

import (
	"context"

	v1 "example.com/target/gen/v1"
	"google.golang.org/grpc"
)

type server struct {
	v1.UnimplementedConfigServiceServer
}

func (server) GetConfig(_ context.Context, request *v1.GetConfigRequest) (*v1.Config, error) {
	return &v1.Config{Value: request.GetName()}, nil
}

func (s server) GetConfigV1(ctx context.Context, request *v1.GetConfigRequest) (*v1.Config, error) {
	return s.GetConfig(ctx, request)
}

func main() {
	v1.RegisterConfigServiceServer(grpc.NewServer(), server{})
}
-- target/proto/v1/config.proto --
syntax = "proto3";

package v1;

option go_package = "example.com/target/gen/v1;v1";

message GetConfigRequest {
  string name = 1;
}

message Config {
  string value = 1;
}

service ConfigService {
  rpc GetConfig(GetConfigRequest) returns (Config);
  rpc GetConfigV1(GetConfigRequest) returns (Config);
}
