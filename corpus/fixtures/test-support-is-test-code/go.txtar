package main

func main() { println(run()) }

func run() int { return 1 }
-- target/main_test.go --
package main

import (
	"testing"

	"example.com/target/testkit"
)

func TestRun(t *testing.T) {
	var store testkit.Store = testkit.New(t)
	if run() != store.Get() {
		t.Fail()
	}
}
-- target/testkit/testkit.go --
package testkit

import "testing"

// New is what the test calls.
func New(t testing.TB) *Fake {
	t.Helper()
	return &Fake{}
}

// Fake is what New returns.
type Fake struct{}

// Get answers the test.
func (*Fake) Get() int { return 1 }

// Store is the interface the test holds the fake as.
type Store interface{ Get() int }

// Orphan is called by nothing.
func Orphan() int { return stranded() }

// stranded is called by Orphan alone.
func stranded() int { return 2 }
