    "paired.B": { "file": "target/main.go", "line": 40 },
    "indexed.C": { "file": "target/main.go", "line": 45 },
    "listed.D": { "file": "target/main.go", "line": 50 },
    "held.E": { "file": "target/main.go", "line": 55 },
