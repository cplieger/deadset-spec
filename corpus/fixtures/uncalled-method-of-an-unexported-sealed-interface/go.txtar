    "UnexportedInterfaceUncalled": { "file": "target/main.go", "line": 9 },
    "UnexportedImplementation": { "file": "target/main.go", "line": 33 },
    "ExportedInterfaceUncalled": { "file": "target/main.go", "line": 15 },
    "ExportedImplementation": { "file": "target/main.go", "line": 37 },
    "EmbeddedInSealed": { "file": "target/main.go", "line": 20 },
