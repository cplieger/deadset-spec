The Go rendering: a library whose options type has a field the library never
touches, and a consumer whose test file alone writes that field.

-- fixture.json --
{
  "symbols": {
    "Options.label": { "file": "target/options.go", "line": 6 },
    "Defaults": { "file": "target/options.go", "line": 10 }
  }
}
-- target/go.mod --
module example.com/target

go 1.27.0
-- target/options.go --
// Package target returns the options a caller adjusts.
package target

// Options holds the settings a caller passes on.
type Options struct {
	Label string
}

// Defaults returns empty options.
func Defaults() *Options { return &Options{} }
-- consumer/go.mod --
module example.com/consumer

go 1.27.0

require example.com/target v0.0.0

replace example.com/target => ../target
-- consumer/main.go --
// Command consumer checks that the target returns options.
package main

import "example.com/target"

func main() { println(target.Defaults() != nil) }
-- consumer/main_test.go --
package main

import (
	"testing"

	"example.com/target"
)

func TestLabel(t *testing.T) {
	options := target.Defaults()
	options.Label = "test"
	if options == nil {
		t.Error("no options")
	}
}
