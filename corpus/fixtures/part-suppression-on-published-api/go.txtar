package lib

//deadset:ignore DS1801 -- The next release reads note.
func Held(note string) int { return 1 }

type Store struct{ n int }

func (s *Store) Mark(committed int) int { //deadset:ignore DS1801 -- An interface of the next release fixes the arity.
	return s.n
}

func Entry(key string) int { return 2 }

//deadset:ignore DS1801 -- Both are reserved for the decoder.
func Both(first, second string) int { return 3 }

func Wrapped(
	first string,
	second string, //deadset:ignore DS1801 -- Both are reserved for the decoder.
) int {
	return 4
}

//deadset:ignore DS1801 -- Kept for a parameter that is read.
func Reads(a, b int) int { return a + b }
