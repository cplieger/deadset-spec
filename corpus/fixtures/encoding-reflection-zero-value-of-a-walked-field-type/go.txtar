The Go rendering: a decoder that walks the field types of the struct a request
body is decoded into, caches each in a member, and asserts an interface on the
zero value of each member's type through reflect.TypeAssert and reflect.Zero.

-- fixture.json --
{
  "symbols": {
    "waitMS.Range": { "file": "target/main.go", "line": 19 },
    "stray.Range": { "file": "target/main.go", "line": 30 }
  }
}
-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
// Command target checks a request body's members against their types' bounds.
package main

import (
	"encoding/json"
	"fmt"
	"os"
	"reflect"
	"sync"
)

// ranged is a member type that publishes its bounds.
type ranged interface{ Range() (lo, hi int64) }

// waitMS is a member type decode checks through ranged.
type waitMS int64

// Range is called only on the zero value of a field type decode walks.
func (waitMS) Range() (lo, hi int64) { return 1, 55000 }

// waitRequest is a request body.
type waitRequest struct {
	WaitMS waitMS `json:"wait_ms"`
}

// stray is a type no reflection reaches.
type stray int64

// Range is called by nothing.
func (stray) Range() (lo, hi int64) { return 1, 10 }

// member is one body member: its Go type and its name.
type member struct {
	typ  reflect.Type
	name string
}

var members sync.Map

// membersOf is struct type t's members, cached by type.
func membersOf(t reflect.Type) []member {
	if cached, hit := members.Load(t); hit {
		if out, isList := cached.([]member); isList {
			return out
		}
	}
	var out []member
	for f := range t.Fields() {
		out = append(out, member{typ: f.Type, name: f.Tag.Get("json")})
	}
	members.Store(t, out)
	return out
}

// deref is the type t points to, or t.
func deref(t reflect.Type) reflect.Type {
	if t.Kind() == reflect.Pointer {
		return t.Elem()
	}
	return t
}

// rangedOf is t's bounds, or those of the type t points to.
func rangedOf(t reflect.Type) (ranged, bool) {
	return reflect.TypeAssert[ranged](reflect.Zero(deref(t)))
}

// present refuses v, member m's value, outside m's bounds.
func present(m member, v json.RawMessage) error {
	if rg, ok := rangedOf(m.typ); ok {
		lo, hi := rg.Range()
		var n int64
		if err := json.Unmarshal(v, &n); err != nil || n < lo || n > hi {
			return fmt.Errorf("%s is out of range", m.name)
		}
	}
	return nil
}

// decode checks raw's members against v's field types, then fills v.
func decode(raw []byte, v any) error {
	var obj map[string]json.RawMessage
	if err := json.Unmarshal(raw, &obj); err != nil {
		return err
	}
	for _, m := range membersOf(reflect.TypeOf(v).Elem()) {
		if err := present(m, obj[m.name]); err != nil {
			return err
		}
	}
	return json.Unmarshal(raw, v)
}

func main() {
	var req waitRequest
	var s stray
	fmt.Println(decode([]byte(os.Args[1]), &req), int64(req.WaitMS))
	println(int64(s))
}
