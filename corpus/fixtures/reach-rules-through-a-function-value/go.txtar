    "literalLevel.Mid": { "file": "target/levels.go", "line": 53 }
  }
}
-- target/go.mod --
module example.com/target

go 1.27.0

require example.com/router v0.0.0

replace example.com/router => ../router
-- target/main.go --
// Command target formats and registers through function values.
package main

import (
	"fmt"
	"log"
	"os"
	"reflect"

	"example.com/router"
)

type label struct{ text string }

// String is called by the formatting package.
func (l label) String() string { return l.text }

type controller struct{}

// Login is registered by name.
func (*controller) Login() {}

// Archive is named by no string.
func (*controller) Archive() {}

// Logout is looked up by name.
func (*controller) Logout() {}

type badge struct{ text string }

// String is called by the logger's formatting.
func (b badge) String() string { return b.text }

type stamp struct{ text string }

// String is called by the logger's formatting through note.
func (s stamp) String() string { return s.text }

type rec struct{ alias string }

type row struct{ title string }

var logTo = (*log.Logger).Printf

// note formats its operands through logTo.
func note(format string, args ...any) {
	logTo(log.Default(), format, args...)
}

func main() {
	printf := fmt.Sprintf
	register := router.Handle
	register("Login", &controller{})
	logf := (*log.Logger).Printf
	logf(log.Default(), "%s", badge{text: "b"})
	note("%s", stamp{text: "s"})
	byName := reflect.Value.MethodByName
	byName(router.Current(), "Logout").Call(nil)
	pick := reflect.Value.MethodByName
	if len(os.Args) > 1 {
		pick = reflect.Value.FieldByName
	}
	other := reflect.Value.FieldByName
	if len(os.Args) > 2 {
		other = reflect.Value.MethodByName
	}
	fmt.Println(pick(reflect.ValueOf(rec{}), "alias"), other(reflect.ValueOf(row{}), "title"))
	fmt.Println(printf("%s", label{text: "t"}))
}
-- router/go.mod --
module example.com/router

go 1.27.0
-- router/router.go --
// Package router maps a route to a method of a handler by name.
package router

import "reflect"

// Handle registers the method of handler that name spells.
func Handle(name string, handler any) {
	_, _ = name, handler
}

// Current is the handler of the route being served.
func Current() reflect.Value { return reflect.Value{} }
-- target/levels.go --
package main

import (
	"bytes"
	"encoding/json"
	"encoding/xml"
	"fmt"
	"os"
)

// fieldLevel is decoded through a decoder a struct field holds.
type fieldLevel int

const (
	fieldLow fieldLevel = iota
	fieldMid
	fieldHigh
	fieldTop
)

// mapLevel is decoded through a decoder a map element holds.
type mapLevel int

const (
	mapLow mapLevel = iota
	mapMid
	mapHigh
)

// methodLevel is decoded through a method value of a *json.Decoder.
type methodLevel int

const (
	methodLow methodLevel = iota
	methodMid
	methodHigh
)

// paramLevel is decoded through a decoder passed as a parameter.
type paramLevel int

const (
	paramLow paramLevel = iota
	paramMid
	paramHigh
)

// literalLevel is passed to a function literal called through a variable.
type literalLevel int

const (
	literalLow literalLevel = iota
	literalMid
	literalHigh
)

// decoders holds a decoder in a field.
type decoders struct {
	decode func([]byte, any) error
}

func init() {
	data := []byte(os.Args[0])
	var a fieldLevel
	h := decoders{decode: json.Unmarshal}
	_ = h.decode(data, &a)
	var b mapLevel
	byName := map[string]func([]byte, any) error{"json": json.Unmarshal}
	_ = byName["json"](data, &b)
	var c methodLevel
	dec := json.NewDecoder(bytes.NewReader(data)).Decode
	_ = dec(&c)
	var e paramLevel
	loaded := load(json.Unmarshal, data, &e) == nil || load(xml.Unmarshal, data, &e) == nil
	same := func(x literalLevel) bool { return x == literalHigh }
	fmt.Println(a == fieldLow || a == fieldHigh, b == mapLow || b == mapHigh, c == methodLow || c == methodHigh)
	fmt.Println(loaded, e == paramLow || e == paramHigh, same(literalLow))
}

// load decodes data into v through decode.
func load(decode func([]byte, any) error, data []byte, v *paramLevel) error { return decode(data, v) }
