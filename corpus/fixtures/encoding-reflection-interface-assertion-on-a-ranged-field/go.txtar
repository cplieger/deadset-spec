-- target/main.go --
// Command target binds its parameters by reflection.
package main

import (
	"reflect"
	"strconv"
)

// ranged is a field type that publishes its bounds.
type ranged interface{ Range() (lo, hi int64) }

// seq is a field type bind fills through ranged.
type seq int64

// Range is called only through Interface and an assertion.
func (seq) Range() (lo, hi int64) { return 1, 9 }

// params is what bind fills.
type params struct {
	Seq seq `json:"seq"`
}

func bind[T any](get func(string) string) T {
	var out T
	v := reflect.ValueOf(&out).Elem()
	for f, fv := range v.Fields() {
		if rg, ok := fv.Interface().(ranged); ok {
			lo, _ := rg.Range()
			n, _ := strconv.ParseInt(get(f.Tag.Get("json")), 10, 64)
			fv.SetInt(max(n, lo))
		}
	}
	return out
}

func main() {
	println(bind[params](func(string) string { return "3" }).Seq)
}
