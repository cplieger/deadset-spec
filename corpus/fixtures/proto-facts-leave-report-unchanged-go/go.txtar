syntax = "proto3";

package v1;

option go_package = "example.com/target/gen/v1;v1";

message PingRequest {
  int32 number = 1;
  string text = 2 [json_name = "words"];
}

message PingResponse {
  int32 number = 1;
}

service PingService {
  rpc Ping(PingRequest) returns (PingResponse);
}
