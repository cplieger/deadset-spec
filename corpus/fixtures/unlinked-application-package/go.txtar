-- target/drivers/template/template.go --
package template

import "example.com/target/server"

func init() { server.Serve(); println(New()) }

// New builds the driver.
func New() *Driver { return &Driver{} }

// Driver is what New builds.
type Driver struct{}
-- target/internal/plugin/plugin.go --
package plugin

// init registers the plugin.
func init() { load() }

// load is what init runs.
func load() {}
-- target/dialect/dialect.go --
package dialect

// init registers the dialect.
func init() { register() }

// register is what init runs.
func register() {}
