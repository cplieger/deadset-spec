{
  "description": "A scope document the invocation names that cannot be read ends the run with the usage code 2, the file named, before any analysis.",
  "products": [
    "deadset",
    "deadset-ts"
  ],
  "argv": [
    "analyze",
    "--target=@TARGET@",
    "--scope=@TARGET@/missing-scope.json"
  ],
  "argv_by_product": {
    "deadset-ts": [
      "analyze",
      "--target=@TARGET@",
      "--scope=@TARGET@/missing-scope.json",
      "--report=@OUT@/report.json"
    ]
  },
  "expect": {
    "exit": 2,
    "stderr_contains": [
      "missing-scope.json"
    ],
    "report": "absent"
  }
}
