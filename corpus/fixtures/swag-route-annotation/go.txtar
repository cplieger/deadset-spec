-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
package main

type handler struct{}

// postAlias documents an alias route.
//
// @Summary Post an alias
// @Router /alias [post]
func (*handler) postAlias() {}

// summarized carries no route.
//
// @Summary Only a summary
func (*handler) summarized() {}

func main() { _ = handler{} }
