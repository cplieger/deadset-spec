-- target/go.mod --
module example.com/target

go 1.27.0

require (
	github.com/goccy/go-yaml v1.0.0
	go.yaml.in/yaml/v2 v2.4.2
	gopkg.in/yaml.v2 v2.4.0
	gopkg.in/yaml.v3 v3.0.1
	sigs.k8s.io/yaml v1.4.0
)

replace (
	github.com/goccy/go-yaml => ../goccy
	go.yaml.in/yaml/v2 => ../yamlin
	gopkg.in/yaml.v2 => ../yamlv2
	gopkg.in/yaml.v3 => ../yaml
	sigs.k8s.io/yaml => ../k8syaml
)
-- target/main.go --
// Command target decodes documents through strict and lenient decoders.
package main

import (
	"bytes"
	"encoding/gob"
	"encoding/json"
	jsonv2 "encoding/json/v2"
	"os"

	goyaml "github.com/goccy/go-yaml"
	yamlin "go.yaml.in/yaml/v2"
	yamlv2 "gopkg.in/yaml.v2"
	"gopkg.in/yaml.v3"
	k8syaml "sigs.k8s.io/yaml"
)

// settings is decoded by a YAML decoder that refuses unknown keys.
type settings struct {
	Name   string `yaml:"name"`
	Theme  string `yaml:"theme"`
	Secret string `yaml:"-"`
}

// request is decoded by a JSON decoder that refuses unknown members.
type request struct {
	ID   string `json:"id"`
	Note string `json:"note"`
}

// cache is decoded by a gob decoder.
type cache struct {
	Hits int
}

// lenient is decoded by a YAML decoder whose switch is turned off.
type lenient struct {
	Name  string `yaml:"name"`
	Extra string `yaml:"extra"`
}

// loose is decoded by a second YAML decoder that takes no switch.
type loose struct {
	Name  string `yaml:"name"`
	Spare string `yaml:"spare"`
}

// manifest is decoded by sigs.k8s.io/yaml with its strict option.
type manifest struct {
	Kind string `json:"kind"`
	Spec string `json:"spec"`
}

// profile is decoded by a goccy YAML decoder made with its strict option.
type profile struct {
	User  string `yaml:"user"`
	Shell string `yaml:"shell"`
}

// flagged is decoded strictly where the command is given an argument.
type flagged struct {
	Name  string `json:"name"`
	Extra string `json:"extra"`
}

// relaxed is decoded by a YAML v2 decoder whose switch is set through a method value.
type relaxed struct {
	Name  string `yaml:"name"`
	Extra string `yaml:"extra"`
}

// pinned is decoded by a YAML v2 decoder whose switch a method expression sets.
type pinned struct {
	Name  string `yaml:"name"`
	Extra string `yaml:"extra"`
}

func checkKeys(data []byte, probe any) error {
	dec := yaml.NewDecoder(bytes.NewReader(data))
	dec.KnownFields(true)
	return dec.Decode(probe)
}

func main() {
	data, err := os.ReadFile("settings.yaml")
	if err != nil {
		os.Exit(1)
	}
	var s settings
	if err := checkKeys(data, &s); err != nil {
		os.Exit(1)
	}
	println(s.Name)
	dec := json.NewDecoder(os.Stdin)
	dec.DisallowUnknownFields()
	var r request
	if err := dec.Decode(&r); err != nil {
		os.Exit(1)
	}
	println(r.ID)
	var c cache
	if err := gob.NewDecoder(bytes.NewReader(data)).Decode(&c); err != nil {
		os.Exit(1)
	}
	off := yaml.NewDecoder(bytes.NewReader(data))
	off.KnownFields(false)
	var l lenient
	if err := off.Decode(&l); err != nil {
		os.Exit(1)
	}
	println(l.Name)
	var o loose
	if err := yaml.NewDecoder(bytes.NewReader(data)).Decode(&o); err != nil {
		os.Exit(1)
	}
	println(o.Name)
	var m manifest
	if err := k8syaml.Unmarshal(data, &m, k8syaml.DisallowUnknownFields); err != nil {
		os.Exit(1)
	}
	println(m.Kind)
	var p profile
	if err := goyaml.NewDecoder(bytes.NewReader(data), goyaml.DisallowUnknownField()).Decode(&p); err != nil {
		os.Exit(1)
	}
	println(p.User)
	var g flagged
	if err := jsonv2.Unmarshal(data, &g, jsonv2.RejectUnknownMembers(len(os.Args) > 1)); err != nil {
		os.Exit(1)
	}
	println(g.Name)
	v2 := yamlv2.NewDecoder(bytes.NewReader(data))
	set := v2.SetStrict
	set(len(os.Args) > 2)
	var x relaxed
	if err := v2.Decode(&x); err != nil {
		os.Exit(1)
	}
	println(x.Name)
	in := yamlin.NewDecoder(bytes.NewReader(data))
	(*yamlin.Decoder).SetStrict(in, true)
	var n pinned
	if err := in.Decode(&n); err != nil {
		os.Exit(1)
	}
	println(n.Name)
}
-- yaml/go.mod --
module gopkg.in/yaml.v3

go 1.27.0
-- yaml/yaml.go --
// Package yaml decodes documents from a reader.
package yaml

import (
	"errors"
	"io"
	"reflect"
)

// Decoder reads documents from a reader.
type Decoder struct {
	r     io.Reader
	known bool
}

// NewDecoder returns a Decoder reading r.
func NewDecoder(r io.Reader) *Decoder { return &Decoder{r: r} }

// KnownFields makes Decode refuse a key the value's type lacks.
func (d *Decoder) KnownFields(enable bool) { d.known = enable }

// Decode fills v from the next document.
func (d *Decoder) Decode(v any) error {
	out := reflect.ValueOf(v)
	if out.Kind() != reflect.Pointer || d.r == nil {
		return errors.New("yaml: Decode needs a non-nil pointer")
	}
	return nil
}
