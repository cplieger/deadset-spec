The Go rendering: a target whose root holds no module file and two modules below
it, the application a requiring the library b through a replace directive and
carrying a replace over a module nothing loads. b declares one function a calls
and one nothing calls.

-- fixture.json --
{
  "symbols": {
    "UnusedReplace": { "file": "target/a/go.mod", "line": 9 },
    "unusedA": { "file": "target/a/main.go", "line": 7 },
    "Used": { "file": "target/b/b.go", "line": 4 },
    "Unused": { "file": "target/b/b.go", "line": 7 }
  }
}
-- target/a/go.mod --
module example.com/a

go 1.27.0

require example.com/b v0.0.0

replace example.com/b => ../b

replace example.com/absent v1.0.0 => ../absent
-- target/a/main.go --
package main

import "example.com/b"

func main() { b.Used() }

func unusedA() {}
-- target/b/go.mod --
module example.com/b

go 1.27.0
-- target/b/b.go --
package b

// Used is what a calls.
func Used() {}

// Unused is called by nothing.
func Unused() {}
