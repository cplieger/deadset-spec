-- target/go.mod --
module example.com/logctx

go 1.27.0
-- target/main.go --
package main

import (
	"context"
	"log/slog"
)

type Payload struct {
	Hidden string
}

type Logged struct {
	Shown string
}

type Context struct {
	context.Context
	Outputs map[string]any
}

func main() {
	ctx := Context{Context: context.Background(), Outputs: map[string]any{"p": Payload{}}}
	slog.InfoContext(ctx, "step", slog.Any("value", Logged{Shown: "s"}))
	_ = ctx.Outputs
}
