// Package protoreflect stands in for the protobuf runtime's reflection package:
// it declares what generated code names and does nothing.
package protoreflect

// Message is a message's reflective view.
type Message interface{}

// Name is a declaration's short name.
type Name string

// FullName is a declaration's full name.
type FullName string

// EnumNumber is an enum value's number.
type EnumNumber int32

// FieldNumber is a field's number.
type FieldNumber int32

// MessageDescriptor describes a message.
type MessageDescriptor interface{}

// FileDescriptor describes a schema file.
type FileDescriptor interface {
	Services() ServiceDescriptors
}

// ServiceDescriptors lists a file's services.
type ServiceDescriptors interface {
	ByName(Name) ServiceDescriptor
}

// ServiceDescriptor describes a service.
type ServiceDescriptor interface {
	Methods() MethodDescriptors
}

// MethodDescriptors lists a service's methods.
type MethodDescriptors interface {
	ByName(Name) MethodDescriptor
}

// MethodDescriptor describes a method.
type MethodDescriptor interface{}

// EnumDescriptor describes an enum.
type EnumDescriptor interface{}

// EnumType is an enum's reflective type.
type EnumType interface {
	Descriptor() EnumDescriptor
}
-- protobuf/runtime/protoimpl/protoimpl.go --
// Package protoimpl stands in for the protobuf runtime package generated code
// builds its descriptors with: it declares what that code names and does nothing.
package protoimpl

import (
	"reflect"
	"unsafe"

	"google.golang.org/protobuf/reflect/protoreflect"
)

// MinVersion and MaxVersion are the generated code versions the runtime supports.
const (
	MinVersion = 20
	MaxVersion = 20
)

// EnforceVersion fails to compile for a generated code version out of range.
type EnforceVersion uint

// Pointer is an untyped message pointer.
type Pointer unsafe.Pointer

// MessageState is the runtime state a generated message holds.
type MessageState struct{}

// LoadMessageInfo reports the state's message information.
func (*MessageState) LoadMessageInfo() *MessageInfo { return nil }

// StoreMessageInfo records the state's message information.
func (*MessageState) StoreMessageInfo(*MessageInfo) {}

// SizeCache caches a message's size.
type SizeCache = int32

// UnknownFields holds a message's unknown fields.
type UnknownFields = []byte

// MessageInfo is a message's runtime information.
type MessageInfo struct {
	GoReflectType reflect.Type
	OneofWrappers []any
}

// MessageOf is a message's reflective view.
func (*MessageInfo) MessageOf(any) protoreflect.Message { return nil }

// Descriptor describes the message.
func (*MessageInfo) Descriptor() protoreflect.MessageDescriptor { return nil }

// EnumInfo is an enum's runtime information.
type EnumInfo struct{}

// Descriptor describes the enum.
func (*EnumInfo) Descriptor() protoreflect.EnumDescriptor { return nil }

// Export is the set of helpers generated code calls.
type Export struct{}

// X is the one Export.
var X Export

// MessageStateOf is the state of a message.
func (Export) MessageStateOf(Pointer) *MessageState { return nil }

// MessageStringOf formats a message.
func (Export) MessageStringOf(any) string { return "" }

// MessageFieldStringOf names a message's field.
func (Export) MessageFieldStringOf(protoreflect.MessageDescriptor, protoreflect.FieldNumber) string {
	return ""
}

// EnumStringOf formats an enum value.
func (Export) EnumStringOf(protoreflect.EnumDescriptor, protoreflect.EnumNumber) string { return "" }

// CompressGZIP compresses a raw descriptor.
func (Export) CompressGZIP(in []byte) []byte { return in }

// DescBuilder holds a file's raw descriptor.
type DescBuilder struct {
	GoPackagePath string
	RawDescriptor []byte
	NumEnums      int32
	NumMessages   int32
	NumExtensions int32
	NumServices   int32
}

// TypeBuilder builds a file's types.
type TypeBuilder struct {
	File              DescBuilder
	GoTypes           []any
	DependencyIndexes []int32
	EnumInfos         []EnumInfo
	MessageInfos      []MessageInfo
}

// Out is what a TypeBuilder builds.
type Out struct {
	File protoreflect.FileDescriptor
}

// Build builds the file.
func (TypeBuilder) Build() Out { return Out{} }
