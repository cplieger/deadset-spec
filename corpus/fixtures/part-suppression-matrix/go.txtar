package main

func main() {
	println(parameterAbove(1, "a"))
	println(parameterTrailing(1, "a"))
	println(parameterEntry(1, "a"))
	println(parameterLive(1, "a"))
	resultAbove()
	resultTrailing()
	resultEntry()
	println(resultLive())
	statementAbove()
	statementTrailing()
	statementEntry()
	statementLive()
	println(storeAbove())
	println(storeTrailing())
	println(storeEntry())
	println(storeLive())
	println(caseAbove(node{}))
	println(caseTrailing(node{}))
	println(caseEntry(node{}))
	println(caseLive(node{}))
}
