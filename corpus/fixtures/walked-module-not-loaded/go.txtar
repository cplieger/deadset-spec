The Go rendering: a target whose root holds no module file, an application module
calling one function of a library module, and a tool module requiring the library
and a module nothing provides.

-- fixture.json --
{
  "symbols": {
    "Used": { "file": "target/lib/lib.go", "line": 4 },
    "Spare": { "file": "target/lib/lib.go", "line": 7 },
    "spare": { "file": "target/lib/lib.go", "line": 10 }
  }
}
-- target/app/go.mod --
module example.com/app

go 1.27.0

require example.com/lib v0.0.0

replace example.com/lib => ../lib
-- target/app/main.go --
package main

import "example.com/lib"

func main() { lib.Used() }
-- target/lib/go.mod --
module example.com/lib

go 1.27.0
-- target/lib/lib.go --
package lib

// Used is what the application calls.
func Used() {}

// Spare is called by nothing loaded.
func Spare() {}

// spare is called by nothing.
func spare() {}
-- target/tool/go.mod --
module example.com/tool

go 1.27.0

require (
	example.com/lib v0.0.0
	example.com/absent v1.0.0
)

replace example.com/lib => ../lib
-- target/tool/main.go --
package main

import (
	"example.com/absent"
	"example.com/lib"
)

func main() { lib.Spare(); absent.Run() }
