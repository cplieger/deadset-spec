module example.com/target

go 1.27.0

require (
	example.com/ext v0.0.0
	github.com/pelletier/go-toml/v2 v2.0.0
	gopkg.in/yaml.v3 v3.0.0
)

replace (
	example.com/ext => ../ext
	github.com/pelletier/go-toml/v2 => ../toml
	gopkg.in/yaml.v3 => ../yaml
)
-- ext/ext.go --
// Package ext is code outside the analyzed program that is handed channels.
package ext

// TakeRecv drains a receive-only channel.
func TakeRecv[T any](c <-chan T) {
	for range c {
	}
}

// TakeSend sends the zero value on a send-only channel.
func TakeSend[T any](c chan<- T) {
	var zero T
	c <- zero
}

// TakeBoth sends the zero value on a channel.
func TakeBoth[T any](c chan T) {
	var zero T
	c <- zero
}
