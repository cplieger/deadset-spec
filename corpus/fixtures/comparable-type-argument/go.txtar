-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
// Command target compares two slices of points and counts its tags.
package main

import "slices"

// Point is compared through a generic comparison of its slices.
type Point struct {
	X int
	Y int
}

// Tag is built and never compared or read.
type Tag struct {
	Name string
}

func main() {
	a := []Point{{X: 1}}
	b := []Point{{X: 1}}
	tags := []Tag{{Name: "x"}}
	println(slices.Equal(a, b), len(tags))
}
