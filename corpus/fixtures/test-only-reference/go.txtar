The Go rendering: one module whose test file references a declaration no
production file references, beside a declaration both the command and the test
file reference. Nothing in the module imports anything outside the standard
library, so the rendering loads with no network access.

-- fixture.json --
{
  "symbols": {
    "OnlyTested": { "file": "target/catalog/catalog.go", "line": 4 },
    "Production": { "file": "target/catalog/catalog.go", "line": 7 }
  }
}
-- target/go.mod --
module example.com/target

go 1.27.0
-- target/catalog/catalog.go --
package catalog

// OnlyTested is referenced from the test file alone.
func OnlyTested() int { return 1 }

// Production is referenced from the command as well as from the test file.
func Production() int { return 2 }
-- target/catalog/catalog_test.go --
package catalog

import "testing"

func TestBothDeclarations(t *testing.T) {
	if OnlyTested() != 1 {
		t.Error("OnlyTested() is not 1")
	}
	if Production() != 2 {
		t.Error("Production() is not 2")
	}
}
-- target/main.go --
package main

import "example.com/target/catalog"

func main() {
	println(catalog.Production())
}
