-- target/parts.go --
package main

//deadset:ignore DS1401 -- The parameter is kept on purpose.
func parameterAbove(value int, label string) int {
	return value * 2
}

func parameterTrailing(value int, label string) int { //deadset:ignore DS1401 -- The parameter is kept on purpose.
	return value * 2
}

func parameterEntry(value int, label string) int {
	return value * 2
}

//deadset:ignore DS1401 -- The parameter is kept on purpose.
func parameterLive(value int, label string) int {
	return value + len(label)
}

//deadset:ignore DS1403 -- The result is kept on purpose.
func resultAbove() int {
	return 1
}

func resultTrailing() int { //deadset:ignore DS1403 -- The result is kept on purpose.
	return 1
}

func resultEntry() int {
	return 1
}

//deadset:ignore DS1403 -- The result is kept on purpose.
func resultLive() int {
	return 2
}

//deadset:ignore DS1405 -- The statement is kept on purpose.
func statementAbove() {
	println("before the return")
	return
	println("after the return")
}

func statementTrailing() { //deadset:ignore DS1405 -- The statement is kept on purpose.
	println("before the return")
	return
	println("after the return")
}

func statementEntry() {
	println("before the return")
	return
	println("after the return")
}

//deadset:ignore DS1405 -- The statement is kept on purpose.
func statementLive() {
	println("only")
}

//deadset:ignore DS1404 -- The store is kept on purpose.
func storeAbove() int {
	count := 1
	count = 2
	return count
}

func storeTrailing() int { //deadset:ignore DS1404 -- The store is kept on purpose.
	count := 1
	count = 2
	return count
}

func storeEntry() int {
	count := 1
	count = 2
	return count
}

//deadset:ignore DS1404 -- The store is kept on purpose.
func storeLive() int {
	count := 1
	count += 2
	return count
}

//deadset:ignore DS1406 -- The case is kept on purpose.
func caseAbove(v any) string {
	switch v.(type) {
	case stringer:
		return "stringer"
	case node:
		return "node"
	}
	return "other"
}

func caseTrailing(v any) string { //deadset:ignore DS1406 -- The case is kept on purpose.
	switch v.(type) {
	case stringer:
		return "stringer"
	case node:
		return "node"
	}
	return "other"
}

func caseEntry(v any) string {
	switch v.(type) {
	case stringer:
		return "stringer"
	case node:
		return "node"
	}
	return "other"
}

//deadset:ignore DS1406 -- The case is kept on purpose.
func caseLive(v any) string {
	switch x := v.(type) {
	case node:
		return "node"
	case stringer:
		return x.str()
	}
	return "other"
}

type stringer interface {
	str() string
}

type node struct{}

func (node) str() string { return "n" }
