-- target/store/store.go --
package store

// Store finds a value by name.
type Store interface {
	Find(name string) string
}

// Plain is the store the command converts to Store.
type Plain struct{}

// Find returns the name it is given.
func (Plain) Find(name string) string { return name }

// Sealed is built by NewSealed alone, and nothing calls NewSealed.
type Sealed struct{ key string }

// Find prefixes the name with the key.
func (s *Sealed) Find(name string) string { return s.key + name }

var _ Store = (*Sealed)(nil)

// NewSealed returns a Sealed store.
func NewSealed() *Sealed { return &Sealed{key: "k"} }

// Cached is built by the command and never converted to Store, so the
// assertion alone states that it satisfies the interface.
type Cached struct{ Name string }

// Find appends the name to the cached one.
func (c *Cached) Find(name string) string { return c.Name + name }

var _ Store = (*Cached)(nil)

// Use finds one name through the interface.
func Use(s Store) string { return s.Find("x") }
