-- target/main.go --
// Command target executes a template read at run time and a constant template
// that invokes a template only a run-time set defines.
package main

import (
	"os"
	"text/template"
)

type page7 struct {
	Title string
	Body  string
	tag   string
}

type item17 struct {
	Name string
	Note string
}

func main() {
	t7 := template.Must(template.New("p").Parse(os.Getenv("PAGE")))
	if err := t7.Execute(os.Stdout, page7{Title: os.Args[0]}); err != nil {
		panic(err)
	}
	t17 := template.Must(template.New("l").Parse(`{{template "x" .}}`))
	template.Must(t17.New("x").Parse(os.Getenv("ROW")))
	if err := t17.Execute(os.Stdout, item17{Name: os.Args[0]}); err != nil {
		panic(err)
	}
}
