// Package protoreflect stands in for the protobuf runtime's reflection package:
// it declares what generated code names and does nothing.
package protoreflect

// Message is a message's reflective view.
type Message interface{}

// Name is a declaration's short name.
type Name string

// FullName is a declaration's full name.
type FullName string

// EnumNumber is an enum value's number.
type EnumNumber int32

// FieldNumber is a field's number.
type FieldNumber int32

// MessageDescriptor describes a message.
type MessageDescriptor interface{}

// FileDescriptor describes a schema file.
type FileDescriptor interface {
	Services() ServiceDescriptors
}

// ServiceDescriptors lists a file's services.
type ServiceDescriptors interface {
	ByName(Name) ServiceDescriptor
}

// ServiceDescriptor describes a service.
type ServiceDescriptor interface {
	Methods() MethodDescriptors
}

// MethodDescriptors lists a service's methods.
type MethodDescriptors interface {
	ByName(Name) MethodDescriptor
}

// MethodDescriptor describes a method.
type MethodDescriptor interface{}

// EnumDescriptor describes an enum.
type EnumDescriptor interface{}

// EnumType is an enum's reflective type.
type EnumType interface {
	Descriptor() EnumDescriptor
}
