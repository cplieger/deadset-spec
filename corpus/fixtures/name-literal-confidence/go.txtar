-- target/go.mod --
module example.com/app

go 1.27.0
-- target/main.go --
package main

import (
	"fmt"
	"sort"

	"example.com/app/api"
	_ "example.com/app/internal/hidden"
)

type holder struct {
	W int `widget`
}

var generated = map[string]int{
	"Spelled":        1,
	"spelledConst":   2,
	"spelledTested":  3,
	"spelledOld":     4,
	"SpelledLocal":   5,
	"SpelledExposed": 6,
	"SpelledGone":    7,
	"spelledRoot":    8,
}

func main() {
	keys := make([]string, 0, len(generated))
	for k := range generated {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	fmt.Println(keys, holder{W: 1}.W, api.SpelledExposed{}, api.TestSpelledExposed{}, api.SelfSpelledExposed{})
}
