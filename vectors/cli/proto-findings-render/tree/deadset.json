{
  "target": {
    "kind": "application"
  },
  "proto": {
    "plugins": [
      "protoc-gen-go"
    ],
    "import_paths": [
      "proto"
    ]
  },
  "providers": {
    "analyzers": [
      {
        "name": "deadset-go",
        "command": "@TARGET@/bin/analyzer",
        "languages": [
          "go"
        ]
      }
    ]
  }
}
