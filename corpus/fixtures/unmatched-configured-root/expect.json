{
  "name": "unmatched-configured-root",
  "description": "A configured root that matches no symbol is reported, once, and the entry beside it that matches a declaration roots that declaration, so the declaration is not reported while an identical one no entry names is. Both outcomes are pinned for an entry holding a wildcard and for an entry holding neither, which is the entry that spells one symbol's reference exactly.",
  "languages": ["go"],
  "target_kind": "application",
  "configured_roots": {
    "RootedPattern": "go://example.com/app#root*",
    "AbsentPattern": "go://example.com/app#absent*",
    "RootedReference": "go://example.com/app#exactRooted",
    "AbsentReference": "go://example.com/app#neverDeclared"
  },
  "expect": [
    {
      "symbol": "AbsentPattern",
      "report": "DS1704",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "root"
    },
    {
      "symbol": "AbsentReference",
      "report": "DS1704",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "root"
    },
    {
      "symbol": "RootedPattern",
      "report": "none"
    },
    {
      "symbol": "RootedReference",
      "report": "none"
    },
    {
      "symbol": "Rooted",
      "report": "none"
    },
    {
      "symbol": "ExactRooted",
      "report": "none"
    },
    {
      "symbol": "PlainDead",
      "report": "DS1002",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "function",
      "liveness_relation": "reference-counting"
    }
  ]
