-- target/go.mod --
module example.com/target

go 1.27.0

require example.com/store v0.0.0

replace example.com/store => ../store
-- target/main.go --
// Command target saves one repository record.
package main

import "example.com/store"

// repo is handed to a package the analysis does not hold the code of.
type repo struct {
	Name string `db:"name"`
}

// TableName satisfies an interface the store package declares.
func (r *repo) TableName() string { return "repos" }

// ResetName satisfies no interface the store package can name.
func (r *repo) ResetName() { r.Name = "" }

func main() {
	if err := store.Save(&repo{Name: "target"}); err != nil {
		panic(err)
	}
}
-- store/go.mod --
module example.com/store

go 1.27.0
-- store/store.go --
// Package store saves records.
package store

// Tabler names the table a record is saved in.
type Tabler interface {
	TableName() string
}

// Save writes a record to the table it names.
func Save(record any) error {
	if t, ok := record.(Tabler); ok && t.TableName() == "" {
		return nil
	}
	return nil
}
