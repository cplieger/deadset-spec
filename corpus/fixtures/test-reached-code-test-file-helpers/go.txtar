-- target/go.mod --
module example.com/target

go 1.27.0
-- target/main.go --
package main

func main() {}
-- target/samples/samples.go --
package samples

// Sample is called by a test alone.
func Sample() int { return 1 }
-- target/main_test.go --
package main

import (
	"testing"

	"example.com/target/samples"
)

var base = 1

func helper() int { return base + 1 }

func TestSample(t *testing.T) {
	if helper() != samples.Sample()+1 {
		t.Fail()
	}
}
