module example.com/app

go 1.27.0
-- target/main.go --
package main

type phase uint8

const (
	phaseIdle phase = iota
	phaseRunning
	phasePaused
	phaseDone
)

const (
	levelLow = iota
	levelHigh
)

const (
	limit = 5
	spare
)

const (
	first = iota
	fixed = 100
)

const (
	base   = iota
	spacer = 100
	tail   = iota
)

type mode uint8

const (
	modeA mode = iota
	modeB
	modeC
)

const (
	spareA = iota
	spareB
)

const scale = 10

const (
	stepA = scale
	stepB = iota
)

func spareScale() int { return scale }

const (
	floor = 5
	ceiling
)

const (
	margin = ceiling
	slot   = iota
)

const (
	lo, loScaled = iota, iota * 2
	hi, hiScaled
)

const (
	pairA,
	pairB = 1, 2
	deadPair,
	livePair
)

const (
	qa,
	qb = 1, 2
	qc,
	qd
)

func main() {
	p := phaseRunning
	println(p == phaseRunning, levelHigh, spare, fixed, tail, stepB, slot, lo, hi, hiScaled, livePair)
}
