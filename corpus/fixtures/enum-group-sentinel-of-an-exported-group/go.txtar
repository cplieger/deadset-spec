-- target/go.mod --
module example.com/lib

go 1.27.0
-- target/lib.go --
// Package lib exports two enumerated types whose last members are unexported
// sentinels.
package lib

// mood is unexported, with exported constants.
type mood int

const (
	MoodSad mood = iota
	moodMid
	MoodHappy
	moodTail
)

// Kind is an exported enumerated type with unexported members between exported ones.
type Kind int

const (
	KindA Kind = iota
	kindHidden
	KindB
	kindTail
)
-- target/marker.go --
package lib

// Marker is the state of a marker file.
type Marker int

const (
	MarkerUnknown Marker = iota
	MarkerFresh
	MarkerStale
)

// Classify reads a marker's age in hours.
func Classify(hours int) Marker {
	if hours < 24 {
		return MarkerFresh
	}
	return MarkerStale
}
-- target/marker_test.go --
package lib

import "testing"

func TestTheZeroMarkerIsUnknown(t *testing.T) {
	var m Marker
	if m != MarkerUnknown {
		t.Fatal("the zero marker is not unknown")
	}
}
