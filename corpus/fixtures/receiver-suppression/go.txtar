-- target/go.mod --
module example.com/app

go 1.27.0
-- target/main.go --
package main

func main() {
	println(counter{}.above(), counter{}.trailing(), counter{}.entry(), counter{n: 1}.live())
}

type counter struct{ n int }

//deadset:ignore DS1802 -- The receiver is kept for the method set.
func (c counter) above() int { return 1 }

func (c counter) trailing() int { //deadset:ignore DS1802 -- The receiver is kept for the method set.
	return 2
}

func (c counter) entry() int { return 3 }

//deadset:ignore DS1802 -- The receiver is kept for the method set.
func (c counter) live() int { return c.n }
