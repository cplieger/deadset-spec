-- target/main.go --
// Command target renders one page.
package main

import (
	"html/template"
	"os"
)

type page struct {
	Title  string
	Unused string
}

const body = `<p title="status online = yes">{{.Title}}</p>`

func main() {
	t := template.Must(template.New("page").Parse(body))
	if err := t.Execute(os.Stdout, page{Title: "t", Unused: "u"}); err != nil {
		panic(err)
	}
}
