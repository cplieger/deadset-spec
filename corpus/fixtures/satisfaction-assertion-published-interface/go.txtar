    "UnexportedInterfaceMethod": { "file": "target/lib.go", "line": 14 },
    "PublishedAssertion": { "file": "target/lib.go", "line": 27 },
    "NamedAssertion": { "file": "target/lib.go", "line": 29 },
    "UnexportedAssertion": { "file": "target/lib.go", "line": 31 },
    "InternalInterface": { "file": "target/internal/inner/inner.go", "line": 3 },
