module github.com/pelletier/go-toml/v2

go 1.27.0
-- toml/toml.go --
// Package toml stands in for go-toml: its decoder takes the destination as any.
package toml

// Unmarshal decodes data into v.
func Unmarshal(data []byte, v any) error {
	_, _ = data, v
	return nil
}
