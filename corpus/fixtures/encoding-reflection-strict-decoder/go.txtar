-- k8syaml/go.mod --
module sigs.k8s.io/yaml

go 1.27.0
-- k8syaml/yaml.go --
// Package yaml decodes YAML documents through a JSON decoder.
package yaml

import (
	"encoding/json"
	"errors"
)

// JSONOpt configures the JSON decoder a document is decoded through.
type JSONOpt func(*json.Decoder) *json.Decoder

// DisallowUnknownFields makes the JSON decoder refuse a key the value's type lacks.
func DisallowUnknownFields(d *json.Decoder) *json.Decoder {
	d.DisallowUnknownFields()
	return d
}

// Unmarshal fills obj from a document.
func Unmarshal(y []byte, obj any, opts ...JSONOpt) error {
	if obj == nil || len(opts) > len(y)+1 {
		return errors.New("yaml: Unmarshal needs a value")
	}
	return nil
}
-- goccy/go.mod --
module github.com/goccy/go-yaml

go 1.27.0
-- goccy/yaml.go --
// Package yaml decodes documents from a reader.
package yaml

import (
	"errors"
	"io"
	"reflect"
)

// Decoder reads documents from a reader.
type Decoder struct {
	r      io.Reader
	strict bool
}

// DecodeOption configures a Decoder.
type DecodeOption func(d *Decoder) error

// DisallowUnknownField makes Decode refuse a key the value's type lacks.
func DisallowUnknownField() DecodeOption {
	return func(d *Decoder) error {
		d.strict = true
		return nil
	}
}

// NewDecoder returns a Decoder reading r.
func NewDecoder(r io.Reader, opts ...DecodeOption) *Decoder {
	d := &Decoder{r: r}
	for _, opt := range opts {
		if err := opt(d); err != nil {
			return nil
		}
	}
	return d
}

// Decode fills v from the next document.
func (d *Decoder) Decode(v any) error {
	out := reflect.ValueOf(v)
	if out.Kind() != reflect.Pointer || d.r == nil {
		return errors.New("yaml: Decode needs a non-nil pointer")
	}
	return nil
}
